#   range where asking for LESS server history would cost the client more.
#
# ScrollbackEnvVar and MinPagingCapacity are not listed: both are referenced from
# non-test engine code (the clamp's own messages and its threshold), so punused
# already sees them.
constant DefaultScrollbackCapacity
function ClampScrollbackCapacity
