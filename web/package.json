{
  "name": "@cplieger/web-terminal-engine",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest --run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@cplieger/web-terminal-engine-v3": "npm:@cplieger/web-terminal-engine@2.8.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/pngjs": "6.0.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "fast-check": "4.9.0",
    "playwright": "1.62.1",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "qs": "^6.15.2"
  },
  "description": "Browser terminal engine: VT500 screen buffer, DOM renderer, and binary wire protocol",
