  "exports": {
    ".": "./src/index.ts",
    "./wire-compatibility.json": "./wire-compatibility.json"
  },
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cplieger/web-terminal-engine.git",
    "directory": "web"
  },
  "homepage": "https://github.com/cplieger/web-terminal-engine",
  "bugs": {
    "url": "https://github.com/cplieger/web-terminal-engine/issues"
  },
  "author": "cplieger <917744+cplieger@users.noreply.github.com>",
  "keywords": [
    "terminal",
    "terminal-emulator",
    "vt100",
    "vt220",
    "vt500",
    "ansi",
    "escape-sequences",
    "renderer",
    "websocket",
    "pty",
    "typescript"
  ],
  "files": [
    "src/",
    "!src/**/*.test.ts",
    "!src/**/*-setup.ts",
    "!src/**/test-helpers/**",
    "jsr.json",
    "LICENSE",
    "wire-compatibility.json"
  ]
